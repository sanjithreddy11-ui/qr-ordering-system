# MongoDB connection string.
#
# For LOCAL DEVELOPMENT, prefer a local MongoDB — this avoids paying a
# network round trip to a remote cluster on every single query, which is
# the most common cause of a "buffering"-feeling admin dashboard on a
# free-tier Atlas cluster. Run `docker compose up -d` from the repo root,
# then use:
#   MONGODB_URI=mongodb://localhost:27017/qr-ordering-system
#
# For PRODUCTION, use your Atlas connection string:
# Get this from Atlas -> Connect -> Drivers -> copy the URI, then replace <password>
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smartqr?retryWrites=true&w=majority

# Port for the backend server
PORT=5000

# Your Next.js frontend URL (for CORS + Socket.io)
CLIENT_ORIGIN=http://localhost:3000

# How long a customer session stays valid after the QR scan (hours)
SESSION_TTL_HOURS=3

# Secret used to sign admin login JWTs. Generate a long random string for
# production, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=8f3a1c9e7b2d4f6a0e8c1b3d5f7a9c2e4b6d8f0a1c3e5b7d9f2a4c6e8b0d3f5a7c9e1b4d6f8a0c2e5b7d9f1a3c6e8b0d

# 2Factor.in — sends the checkout OTP (see src/config/twoFactor.js). No
# DLT registration needed for this route. Get your key from
# 2factor.in -> My Account -> Account Summary.
TWOFACTOR_API_KEY=your-2factor-api-key-here

# QZ Tray print signing — lets QZ Tray remember "trust this app" once
# instead of prompting on every print job. For local dev, leave these
# unset and instead generate backend/certs/ once with:
#   openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
#     -subj "/CN=Your Restaurant QZ Signing" \
#     -keyout backend/certs/private-key.pem \
#     -out backend/certs/digital-certificate.txt
# For production, generate your own cert/key pair and set both here as
# single-line PEM text with real newlines escaped as \n:
