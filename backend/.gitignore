# dependencies
/node_modules

# env files — contains live secrets (Mongo URI, JWT_SECRET). Never commit.
.env
.env.*
!.env.example

# uploaded admin images (local dev storage)
/public/uploads/*
!/public/uploads/.gitkeep

# QZ Tray signing cert/key generated for local dev — never commit these.
